[Unit]
Description=Neuron testnet reference file service on loopback
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=neuron-testnet
Group=neuron-testnet
WorkingDirectory=/var/lib/neuron-customer-testnet
Environment=NEURON_REFERENCE_CONFIG_FILE=/var/lib/neuron-customer-testnet/reference-config.json
Environment=NEURON_REFERENCE_API_TOKEN_FILE=/var/lib/neuron-customer-testnet/reference-api-token
Environment=NEURON_REFERENCE_STATE_DIR=/var/lib/neuron-customer-testnet/reference-sessions
Environment=NEURON_REFERENCE_LISTEN=127.0.0.1:8098
Environment=GOMEMLIMIT=200MiB
ExecStart=/var/lib/neuron-customer-testnet/bin/neuron-reference
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
StateDirectory=neuron-customer-testnet
StateDirectoryMode=0700
ReadWritePaths=/var/lib/neuron-customer-testnet
MemoryMax=300M
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
