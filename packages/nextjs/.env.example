# Optional: copy to packages/nextjs/.env.local for local development.
# The app starts read-only without this file or any credentials.
# Full configuration: ../../docs/configuration.md
HEDERA_NETWORK=testnet
HEDERA_ALLOW_MAINNET_WRITES=false

# Enable only the adapter you configure. Every write path is off by default.
NEURON_ENABLE_CUSTOMER_AUTH=false
NEURON_ENABLE_REFERENCE_COMMERCE=false
NEURON_ENABLE_LOCAL_STREAM=false
NEURON_ENABLE_REMOTE_STREAM=false
NEURON_ENABLE_CUSTOMER_REQUEST=false
NEURON_ENABLE_PUBLIC_CUSTOMER_REQUEST=false
NEURON_ENABLE_CUSTOMER_COMMERCE_REVIEW=false
NEURON_ENABLE_CUSTOMER_FUNDING=false
NEURON_ENABLE_CUSTOMER_APPROVAL=false

# Testnet sign-in: choose one exact origin and an existing owner-only directory.
# A public HTTPS origin also requires an explicit checksummed wallet allowlist.
# NEURON_APP_ORIGIN=http://127.0.0.1:3000
# NEURON_CUSTOMER_DB_FILE=/absolute/owner-only/customer.sqlite
# NEURON_ALLOWED_CUSTOMER_ADDRESSES=YOUR_CHECKSUMMED_EVM_ADDRESS
# Optional WalletConnect relay project (injected browser wallets do not need it):
# NEURON_REOWN_PROJECT_ID=YOUR_PROJECT_ID

# Reference file service: configure/start the private bridge first.
# Its bearer file must be outside the repository, mode 0600 in a 0700 directory.
# NEURON_REFERENCE_URL=http://127.0.0.1:8098
# NEURON_REFERENCE_API_TOKEN_FILE=/absolute/owner-only/reference-api-token

# Legacy stream and native-HBAR options have separate setup requirements.
# See ../../docs/configuration.md and ../../deploy/testnet/README.md.
# Owned native-HBAR seller discovery (optional, no hosted registration needed):
# NEURON_SELLER_DISCOVERY=direct
# NEURON_DIRECT_SELLER_PROFILE_FILE=/absolute/owner-only/seller-profile.json
# Full provisioning, quote and delivery steps: ../../docs/native-seller.md.
# Never put a private key or bearer token in NEXT_PUBLIC_* variables.
