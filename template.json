{
  "name": "Neuron Customer App Starter",
  "description": "Next.js Neuron service discovery, reference file delivery and Hedera evidence with separate Foundry contracts",
  "version": "0.1.0",
  "create-scaffold-hbar": {
    "capabilities": {
      "frontend": ["nextjs-app"],
      "solidityFramework": ["foundry"],
      "packageManager": ["npm"]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "foundry",
      "packageManager": "npm"
    },
    "requirements": {
      "node": "^22.23.3 || ^24.21.0"
    },
    "outro": {
      "installCommand": "npm ci --engine-strict",
      "sections": [
        {
          "title": "Verify the template",
          "steps": [
            { "command": "npm run verify" }
          ]
        },
        {
          "title": "Run the browser smoke tests",
          "steps": [
            { "command": "npx playwright install chromium" },
            { "command": "npm run build" },
            { "command": "npm run test:e2e" }
          ]
        },
        {
          "title": "Run the read-only app",
          "steps": [
            { "command": "npm run dev" },
            { "text": "No credentials are needed for read-only mode. See README.md and docs/configuration.md to enable a testnet adapter." }
          ]
        }
      ]
    }
  }
}
