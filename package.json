{
  "name": "hedera-data-commerce-starter",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": "^22.23.3 || ^24.21.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @neuron/hedera && npm run build -w @neuron/foundry && npm run build -w @neuron/nextjs",
    "typecheck": "npm run typecheck -w @neuron/hedera && npm run typecheck -w @neuron/nextjs && node scripts/tsc.mjs -p e2e",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build -w @neuron/hedera && npm run build -w @neuron/nextjs && npm run test -w @neuron/hedera && npm run test -w @neuron/foundry && npm run test -w @neuron/nextjs",
    "verify": "node scripts/verify.mjs",
    "test:live": "npm run build -w @neuron/hedera && npm run test:live -w @neuron/hedera",
    "hcs:submit": "cd packages/neuron-go && go run ./cmd/hcs-submit",
    "reference:build": "node packages/neuron-reference/scripts/prepare.mjs",
    "reference:setup": "cd packages/neuron-go && go run ./cmd/reference-setup",
    "contract:deploy": "npm run build -w @neuron/foundry && npm run deploy -w @neuron/foundry",
    "dev": "npm run build -w @neuron/hedera && npm run dev -w @neuron/nextjs",
    "start": "npm run start -w @neuron/nextjs",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "check:scaffold-text": "node scripts/check-scaffold-text.mjs",
    "check:scaffold": "node scripts/scaffold-gate.mjs",
    "test:e2e": "playwright test",
    "native:quote": "npm run build -w @neuron/hedera && node packages/neuron-hedera/scripts/native-quote.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:tooling": "node --test scripts/test/*.test.mjs scripts/verify-evidence.test.mjs packages/neuron-reference/scripts/prepare-cache.test.mjs",
    "check:evidence": "node scripts/verify-evidence.mjs"
  },
  "devDependencies": {
    "@eslint-community/eslint-utils": "4.10.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0"
  },
  "allowScripts": {
    "@foundry-rs/forge@1.7.1": true,
    "better-sqlite3@13.0.3": true
  },
  "overrides": {
    "unstorage": "1.17.5"
  }
}
